{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "7a. MAP 2. Proportional symbol map: bulk grain shipped through each port, October 2021 to September 2022 (the last year the ACCC published). Circle AREA is proportional to tonnes shipped. Port Pirie shipped nothing that year (open ring). Projection: Australian Albers (conic equal-area, centred on 132 degrees E). Source: ACCC bulk grain ports monitoring report, data update 2021-22; port locations from Natural Earth and others (see data README).",
  "width": "container",
  "height": 470,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "fit": {
      "type": "Feature",
      "properties": {},
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [
          [
            112.6,
            -25.5
          ],
          [
            113.1,
            -26.3
          ],
          [
            142.2,
            -9.0
          ],
          [
            154.2,
            -28.6
          ],
          [
            146.8,
            -43.8
          ],
          [
            115.0,
            -35.2
          ],
          [
            129.0,
            -14.8
          ],
          [
            150.0,
            -41.0
          ]
        ]
      }
    }
  },
  "layer": [
    {
      "description": "BASE MAP: the states, in a quiet grey.",
      "data": {
        "url": "data/aus_sa2_states_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E9E6DF",
        "stroke": "#FFFFFF",
        "strokeWidth": 1,
        "clip": true
      }
    },
    {
      "description": "PORTS: one circle per port. Area = tonnes shipped. Other grains = total minus wheat, barley and canola (see data README, Queensland).",
      "data": {
        "url": "data/accc_ports_2021-22.csv",
        "format": {
          "type": "csv",
          "parse": {
            "facilities": "number",
            "wheat_mt": "number",
            "barley_mt": "number",
            "canola_mt": "number",
            "other_mt": "number",
            "total_mt": "number",
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.total_mt > 0"
        },
        {
          "calculate": "max(0, datum.total_mt - datum.wheat_mt - datum.barley_mt - datum.canola_mt)",
          "as": "other_grains_mt"
        },
        {
          "calculate": "datum.facilities === 1 ? '1 terminal' : datum.facilities + ' terminals'",
          "as": "terminals"
        }
      ],
      "params": [
        {
          "name": "hover_port",
          "select": {
            "type": "point",
            "fields": [
              "port"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "total_mt",
          "type": "quantitative",
          "title": "Grain shipped, million tonnes",
          "scale": {
            "type": "linear",
            "zero": true,
            "domain": [
              0,
              6.5
            ],
            "range": [
              0,
              1800
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 0,
            "legendY": 4,
            "direction": "horizontal",
            "values": [
              1,
              3,
              6
            ],
            "symbolFillColor": "#4D4D4D",
            "symbolOpacity": 0.75,
            "symbolStrokeColor": "#FFFFFF",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "titlePadding": 8,
            "columnPadding": 14,
            "titleLimit": 300
          }
        },
        "color": {
          "value": "#4D4D4D"
        },
        "opacity": {
          "value": 0.75
        },
        "stroke": {
          "condition": {
            "param": "hover_port",
            "empty": false,
            "value": "#000"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover_port",
            "empty": false,
            "value": 2.5
          },
          "value": 1
        },
        "order": {
          "field": "total_mt",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "port",
            "type": "nominal",
            "title": "Port"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "total_mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "All bulk grain (million tonnes)"
          },
          {
            "field": "wheat_mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Wheat"
          },
          {
            "field": "barley_mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Barley"
          },
          {
            "field": "canola_mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Canola"
          },
          {
            "field": "other_grains_mt",
            "type": "quantitative",
            "format": ".2f",
            "title": "Other grains"
          },
          {
            "field": "terminals",
            "type": "nominal",
            "title": "Grain terminals"
          }
        ]
      }
    },
    {
      "description": "PORT PIRIE: listed by the ACCC but shipped no grain in 2021-22, so it is an open ring rather than a circle.",
      "data": {
        "url": "data/accc_ports_2021-22.csv",
        "format": {
          "type": "csv",
          "parse": {
            "total_mt": "number",
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.total_mt === 0"
        },
        {
          "calculate": "'no grain shipped in 2021-22'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "size": 40,
        "filled": false,
        "stroke": "#4D4D4D",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "port",
            "type": "nominal",
            "title": "Port"
          },
          {
            "field": "note",
            "type": "nominal",
            "title": "2021-22"
          }
        ]
      }
    },
    {
      "description": "LABELS for the nine busiest ports, as in the sketch. West- and east-coast labels sit inland beside their circle; south-coast labels sit below, out at sea. Each label is pushed out by its own circle's radius (radius grows with the square root of tonnes), so big circles don't cover their labels. Offsets are in degrees.",
      "data": {
        "url": "data/accc_ports_2021-22.csv",
        "format": {
          "type": "csv",
          "parse": {
            "total_mt": "number",
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "busy_rank"
            }
          ],
          "sort": [
            {
              "field": "total_mt",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.busy_rank <= 9"
        },
        {
          "calculate": "indexof(['Kwinana', 'Geraldton'], datum.port) >= 0 ? 'east' : indexof(['Brisbane', 'Newcastle', 'Port Kembla'], datum.port) >= 0 ? 'west' : datum.port === 'Port Adelaide' ? 'southwest' : 'south'",
          "as": "side"
        },
        {
          "calculate": "0.45 + 0.67 * sqrt(datum.total_mt)",
          "as": "push_deg"
        },
        {
          "calculate": "datum.side === 'east' ? datum.lon + datum.push_deg : datum.side === 'west' ? datum.lon - datum.push_deg : datum.side === 'southwest' ? datum.lon - 0.2 : datum.lon",
          "as": "label_lon"
        },
        {
          "calculate": "datum.side === 'south' || datum.side === 'southwest' ? datum.lat - datum.push_deg : datum.port === 'Kwinana' ? datum.lat + 0.7 : datum.lat",
          "as": "label_lat"
        },
        {
          "calculate": "datum.port + ' ' + format(datum.total_mt, '.1f')",
          "as": "label"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.side === 'east'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12.5,
            "color": "#222"
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'west'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "fontSize": 12.5,
            "color": "#222"
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'south'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "top",
            "fontSize": 12.5,
            "color": "#222"
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side === 'southwest'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "fontSize": 12.5,
            "color": "#222"
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ]
}
