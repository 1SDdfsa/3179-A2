{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "2b. Horizontal bars: forecast winter crop production by state, 2026-27, in million tonnes, largest first. Click a bar to highlight that state on Map 1 (2a). Source: ABARES Australian Crop Report, September 2026, Table 1.",

  "width": "container",
  "height": 190,

  "data": {
    "url": "data/abares_winter_production.csv",
    "format": {
      "type": "csv",
      "parse": {"year_start": "number", "production_kt": "number"}
    }
  },

  "transform": [
    {"filter": "datum.year === '2026-27'"},
    {"calculate": "datum.region === 'Australia' ? datum.production_kt : 0", "as": "aus_kt"},
    {"joinaggregate": [{"op": "sum", "field": "aus_kt", "as": "australia_kt"}]},
    {"filter": "datum.region !== 'Australia'"},
    {
      "calculate": "{'Western Australia': 'WA', 'New South Wales': 'NSW', 'South Australia': 'SA', 'Victoria': 'Vic', 'Queensland': 'Qld', 'Tasmania': 'Tas'}[datum.region]",
      "as": "state"
    },
    {"calculate": "datum.production_kt / 1000", "as": "production_mt"},
    {"calculate": "datum.production_kt / datum.australia_kt", "as": "share"},
    {"calculate": "format(datum.production_mt, '.1f') + ' Mt'", "as": "label"},
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "production_kt", "order": "descending"}]
    }
  ],

  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {"field": "rank", "op": "min", "order": "ascending"},
      "title": null,
      "axis": {"domain": false, "ticks": false, "labelFontSize": 14, "labelColor": "#222", "labelPadding": 8, "minExtent": 44}
    },
    "x": {
      "field": "production_mt",
      "type": "quantitative",
      "title": null,
      "axis": null,
      "scale": {"domainMax": 31}
    }
  },

  "layer": [
    {
      "params": [
        {
          "name": "pick_state",
          "select": {"type": "point", "fields": ["region"], "on": "click", "clear": "dblclick"}
        },
        {
          "name": "hover_bar",
          "select": {"type": "point", "fields": ["region"], "on": "pointerover", "clear": "pointerout"}
        }
      ],
      "mark": {"type": "bar", "cornerRadiusEnd": 2, "height": {"band": 0.72}, "cursor": "pointer"},
      "encoding": {
        "color": {
          "field": "region",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Western Australia", "New South Wales", "South Australia", "Victoria", "Queensland", "Tasmania"],
            "range": ["#525252", "#6B6B6B", "#848484", "#9D9D9D", "#BDBDBD", "#D4D4D4"]
          }
        },
        "stroke": {
          "condition": [
            {"param": "pick_state", "empty": false, "value": "#000"},
            {"param": "hover_bar", "empty": false, "value": "#000"}
          ],
          "value": null
        },
        "strokeWidth": {
          "condition": {"param": "pick_state", "empty": false, "value": 2},
          "value": 1
        },
        "opacity": {
          "condition": {"param": "pick_state", "value": 1},
          "value": 0.3
        },
        "tooltip": [
          {"field": "region", "type": "nominal", "title": "State"},
          {"field": "production_mt", "type": "quantitative", "format": ".1f", "title": "Winter crop, 2026-27 forecast (million tonnes)"},
          {"field": "share", "type": "quantitative", "format": ".0%", "title": "Share of Australia's winter crop"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 6, "fontSize": 13, "color": "#555"},
      "encoding": {
        "text": {"field": "label"},
        "opacity": {
          "condition": {"param": "pick_state", "value": 1},
          "value": 0.3
        }
      }
    }
  ]
}
